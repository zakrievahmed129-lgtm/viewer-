<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_space_screen"
    android:fillViewport="true"
    android:overScrollMode="never">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <!-- ================================================================== -->
        <!-- EN-TÊTE : LOGO SPATIAL & BADGE DE CONNEXION CLOUD                  -->
        <!-- ================================================================== -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GHOSTLOCK"
                android:textColor="@color/text_primary"
                android:textSize="21sp"
                android:letterSpacing="0.08"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="VISION BIOMETRIC SHIELD"
                android:textColor="@color/accent_indigo"
                android:textSize="10sp"
                android:letterSpacing="0.16"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCloudStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_connected"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="● CLOUD CONNECTÉ"
            android:textColor="@color/emerald"
            android:textSize="11sp"
            android:letterSpacing="0.04"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/headerLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/headerLayout" />

        <!-- ================================================================== -->
        <!-- CARTE CENTRALE VISION PRO : RADAR & STATUT PC                      -->
        <!-- ================================================================== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardPcStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toBottomOf="@id/headerLayout">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="18dp">

                <!-- EN-TÊTE DE CARTE : SÉLECTEUR D'APPAREIL SPATIAL VISION PRO (UNIFIÉ & ÉPURÉ) -->
                <LinearLayout
                    android:id="@+id/layoutPcSelectorHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_badge"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true">

                    <!-- Écrin de verre de l'icône appareil -->
                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_icon_squircle">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="🖥️"
                            android:textSize="18sp" />
                    </FrameLayout>

                    <!-- Informations machine cible : Nom principal + Action tactile -->
                    <LinearLayout
                        android:id="@+id/layoutPcNameClickable"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvPcName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="pc-zakriev"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvBtnChangePc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="▾"
                                android:textColor="#38BDF8"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvDiscoveredCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="1 PC mémorisé • Toucher pour changer"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Badge de statut en ligne / hors ligne autonome & net -->
                    <TextView
                        android:id="@+id/tvPcLiveStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_status_pill"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:singleLine="true"
                        android:maxLines="1"
                        android:ellipsize="none"
                        android:text="● HORS LIGNE"
                        android:textColor="@color/rose"
                        android:textSize="10sp"
                        android:letterSpacing="0.04"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- RADAR BIOMÉTRIQUE SPATIAL (ÉCHO DU CADENAS PC) -->
                <FrameLayout
                    android:layout_width="144dp"
                    android:layout_height="144dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="12dp">

                    <!-- Onde de Choc Spatiale Dynamique (Déverrouillage / Verrouillage) -->
                    <View
                        android:id="@+id/radarShockwave"
                        android:layout_width="82dp"
                        android:layout_height="82dp"
                        android:layout_gravity="center"
                        android:alpha="0"
                        android:background="@drawable/bg_radar_shockwave_emerald" />

                    <!-- Anneau Extérieur Pulsant -->
                    <View
                        android:id="@+id/radarRingOuter"
                        android:layout_width="144dp"
                        android:layout_height="144dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_radar_ring_outer" />

                    <!-- Anneau Intermédiaire Pulsant -->
                    <View
                        android:id="@+id/radarRingMid"
                        android:layout_width="112dp"
                        android:layout_height="112dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_radar_ring_mid" />

                    <!-- Hub Central du Cadenas -->
                    <FrameLayout
                        android:id="@+id/hubBiometric"
                        android:layout_width="82dp"
                        android:layout_height="82dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_biometric_hub">

                        <ImageView
                            android:id="@+id/ivLockIcon"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_padlock_locked"
                            app:tint="@color/rose" />
                    </FrameLayout>
                </FrameLayout>

                <!-- Texte du Statut de Verrouillage -->
                <TextView
                    android:id="@+id/tvLockStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="PC ACTUELLEMENT VERROUILLÉ 🔒"
                    android:textColor="@color/rose"
                    android:textSize="14sp"
                    android:letterSpacing="0.04"
                    android:textStyle="bold" />

                <!-- Horodatage du Heartbeat -->
                <TextView
                    android:id="@+id/tvLastSeen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:text="En attente du signal du PC..."
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ================================================================== -->
        <!-- BOUTONS D'ACTION TACTILE VISION PRO (ORGANISÉS & COMPACTS)         -->
        <!-- ================================================================== -->

        <!-- 1. Bouton Hero Principal : Déverrouillage par Empreinte -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnUnlockBiometric"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_btn_unlock"
            android:text="DÉVERROUILLER AVEC L'EMPREINTE 👆"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:letterSpacing="0.03"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            app:layout_constraintTop_toBottomOf="@id/cardPcStatus" />

        <!-- 2. Rangée Duo d'Actions Secondaires (Verrouiller & Viewer côte-à-côte) -->
        <LinearLayout
            android:id="@+id/layoutSecondaryActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/btnUnlockBiometric">

            <!-- Verrouiller à distance -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLockPc"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_btn_lock"
                android:text="🔒 VERROUILLER"
                android:textColor="@color/rose"
                android:textSize="12sp"
                android:textStyle="bold"
                android:stateListAnimator="@null" />

            <!-- Ouvrir le Viewer -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOpenViewer"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_btn_ghost"
                android:text="👻 VIEWER PC"
                android:textColor="@color/ghost_text"
                android:textSize="12sp"
                android:textStyle="bold"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- ================================================================== -->
        <!-- MODULE PROXIMITÉ BLUETOOTH RSSI (CARTE VERRE SPATIAL)              -->
        <!-- ================================================================== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardProximity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toBottomOf="@id/layoutSecondaryActions">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp"
                android:paddingVertical="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Auto-verrouillage à l'éloignement"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Le PC se verrouille si vous quittez la pièce"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchProximity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ================================================================== -->
        <!-- MODULE DIFFUSION TÉLÉPHONE VERS PC (VISION PRO SPATIAL GLASS)      -->
        <!-- ================================================================== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardPhoneStream"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toBottomOf="@id/cardProximity">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DIFFUSION VERS LE PC 💻"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvStreamStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Inactif • Prêt à diffuser"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStreamIp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_badge"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text=":8888"
                        android:textColor="@color/emerald"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnStreamScreen"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_btn_stream"
                        android:text="📱 ÉCRAN"
                        android:textColor="#06B6D4"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:stateListAnimator="@null" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnStreamCamera"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_btn_stream_cam"
                        android:text="📷 CAMÉRA"
                        android:textColor="#C084FC"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:stateListAnimator="@null" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnStopStream"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_btn_stream_stop"
                    android:text="⏹ ARRÊTER LA DIFFUSION"
                    android:textColor="@color/rose"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:stateListAnimator="@null" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ================================================================== -->
        <!-- CONSOLE JOURNALISÉE MINIMALISTE                                    -->
        <!-- ================================================================== -->
        <TextView
            android:id="@+id/tvLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="Système actif • Prêt pour authentification"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            app:layout_constraintTop_toBottomOf="@id/cardPhoneStream"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
