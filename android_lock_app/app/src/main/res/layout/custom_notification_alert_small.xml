<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_alert_card"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notif_badge_small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_alert_badge"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="🚨 GHOST ALERT"
            android:textColor="#00F0FF"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_title_small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Message du PC 💻"
            android:textColor="#00F0FF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_time_small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="14:15"
            android:textColor="#94A3B8"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/notif_message_small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Texte du message..."
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

</LinearLayout>
